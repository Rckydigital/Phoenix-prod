# Email (Resend) - pour le formulaire de contact
# Crée un compte sur resend.com et remplace par ta clé API
RESEND_API_KEY=re_XXXXXXXXXXXXXXXX
CONTACT_EMAIL=rckydigital@outlook.fr
# Expéditeur vérifié dans Resend (par défaut onboarding@resend.dev)
CONTACT_FROM_EMAIL=

# URL du site en production
NEXT_PUBLIC_SITE_URL=https://phoenixprod.fr

# Calendly - remplace par ton lien de calendrier
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/rckydigital

# CRM : chaque demande devient une fiche dans le cerveau (GitHub)
# Jeton fine-grained : dépôt cerveau-ricky-galin uniquement, Contents : Read and write
CRM_GITHUB_TOKEN=
CRM_GITHUB_REPO=Rckydigital/cerveau-ricky-galin

# QG virtuel (/qg) : mot de passe d’accès
QG_PASSWORD=

# Google Search Console : contenu de la balise de validation (sans les guillemets)
GOOGLE_SITE_VERIFICATION=
